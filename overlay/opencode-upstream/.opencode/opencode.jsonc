{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {
      "options": {}
    }
  },
  "mcp": {
    "MCP_DOCKER": {
      "type": "local",
      "command": ["docker", "mcp", "gateway", "run"],
      "enabled": true
