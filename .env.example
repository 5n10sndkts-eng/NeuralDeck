# NeuralDeck Environment Configuration
# Copy this file to .env.local and fill in your values

# ================================================
# VISION AI (R-003 Security Mitigation)
# ================================================
# OpenAI API Key for GPT-4V Vision Analysis
# CRITICAL: Store ONLY on server-side, NEVER commit to git
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Alternative: Use GPT4V_API_KEY if you prefer
# GPT4V_API_KEY=sk-your-api-key-here

# Gemini API Key (Google AI Studio)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ================================================
# SERVER CONFIGURATION
# ================================================
PORT=3001
HOST=127.0.0.1
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_PORT=4096
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional: override the default local model used for developer/tactical routing.
OLLAMA_DEFAULT_MODEL=deepseek

# CORS allowlist (comma-separated origins)
# Example: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Socket.IO CORS allowlist (defaults to CORS_ORIGINS if omitted)
SOCKET_CORS_ORIGINS=

# ================================================
# SECURITY CONFIGURATION (Story 6-4)
# ================================================
# JWT Secret for session tokens (generate with: openssl rand -hex 32)
# CRITICAL: Change this in production!
JWT_SECRET=change-this-to-a-random-32-byte-hex-string

# Session expiry in seconds (default: 86400 = 24 hours)
SESSION_EXPIRY=86400

# Allow interpreter commands in /api/mcp/call (node/python/npm). Default: false
ALLOW_INTERPRETERS=false

# Allow unauthenticated Socket.IO connections (NOT recommended). Default: false
ALLOW_UNAUTHENTICATED_SOCKET=false

# LLM base URL allowlists (comma-separated). Use host allowlist for local servers.
LLM_HOST_ALLOWLIST=localhost,127.0.0.1,::1,192.168.100.190,generativelanguage.googleapis.com
# Optional strict origin allowlist (protocol + host[:port])
LLM_ORIGIN_ALLOWLIST=

# Gemini OpenAI-compatible base URL override (optional)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# CSP report URI (optional)
CSP_REPORT_URI=/api/csp-report

# ================================================
# FRONTEND API CONFIGURATION (Vite)
# ================================================
# Backend API base URL (used by frontend)
VITE_API_BASE=http://localhost:3001/api

# WebSocket server URL (used by frontend)
VITE_SOCKET_URL=http://localhost:3001

# OpenCode server URL (used by frontend OpenCode SDK hook)
VITE_OPENCODE_URL=http://127.0.0.1:4096

# ================================================
# MCP INTEGRATION (Docker MCP Toolkit)
# ================================================
# N8N Workflow Automation (42 tools: workflows, executions, nodes)
# Get API key from: http://localhost:5678/settings/api
N8N_API_URL=http://localhost:5678
N8N_API_KEY=n8n_api_your-api-key-here

# GitHub Official API (70+ tools: repos, issues, PRs, code search)
# REQUIRED for github-official MCP server
# Scopes: repo, workflow, read:org, read:user
# Get from: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your-github-pat-here

# MCP Toolkit Features
# Enable OAuth interceptor for automatic GitHub auth flows
MCP_ENABLE_OAUTH_INTERCEPTOR=true

# Disable tool name prefixes (e.g., "github_" prefix)
MCP_ENABLE_TOOL_PREFIX=false

# Enable semantic search for mcp-find (requires OPENAI_API_KEY)
MCP_ENABLE_EMBEDDINGS=true

# Enabled MCP Servers (comma-separated)
# - context7: Library documentation access
# - deepwiki: GitHub repository analysis
# - docker: Container management and Dockerfile operations
# - fetch: Web content fetching and parsing
# - github-official: GitHub API integration (requires PAT)
# - n8n: Workflow automation (requires API key)
# - npm-sentinel: NPM package security analysis
# - playwright: Browser automation and testing
# - sequentialthinking: AI reasoning and problem-solving
MCP_SERVERS_ENABLED=context7,fetch,n8n,playwright,sequentialthinking,github-official,npm-sentinel,docker,deepwiki

# ================================================
# SECURITY NOTES
# ================================================
# - API keys are read server-side only (server.cjs)
# - Client code NEVER has access to API keys
# - All Vision API calls go through /api/vision/analyze backend proxy
# - If API key is not set, system falls back to local-only mode
# - Add .env.local to .gitignore to prevent accidental commits
# - JWT tokens are stored in memory, not localStorage
# - Sessions are validated on every WebSocket connection
# - CSRF protection is enabled for all POST/PUT/DELETE requests
