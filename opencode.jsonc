{
  "$schema": "https://opencode.ai/config.json",
  
  // ================================================
  // NEURALDECK + OPENCODE CONFIGURATION
  // ================================================
  // Minimal valid configuration for OpenCode CLI
  // Uses Docker MCP Toolkit for all 9 MCP servers
  
  // ================================================
  // MCP SERVER CONFIGURATION
  // ================================================
  // All 9 MCP servers are provided by Docker MCP Toolkit:
  // - context7: Library documentation (2 tools)
  // - deepwiki: GitHub repo analysis (1 tool)
  // - docker: Container management (25 tools)
  // - fetch: Web content fetching (1 tool)
  // - github-official: GitHub API (70+ tools) - requires GITHUB_PERSONAL_ACCESS_TOKEN
  // - n8n: Workflow automation (42 tools) - requires N8N_API_KEY
  // - npm-sentinel: NPM security (20 tools)
  // - playwright: Browser automation (25 tools)
  // - sequentialthinking: AI reasoning (1 tool)
  
  "mcp": {
    // Docker MCP Toolkit - Gateway to all 9 MCP servers
    "MCP_DOCKER": {
      "type": "local",
      "command": ["docker", "mcp", "gateway", "run"],
      "enabled": true
    }
  }
}
